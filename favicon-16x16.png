/* PORTFOLIO PAGE — portfolio.css */

.pg-glow {
  position:absolute; width:700px; height:700px;
  background:radial-gradient(circle,rgba(79,142,247,.1) 0%,transparent 65%);
  border-radius:50%; filter:blur(80px);
  top:-150px; left:-150px; pointer-events:none; z-index:0;
}

/* FILTER */
.port-sec { padding:40px 6% 80px; }
.filters { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-bottom:50px; }
.fb {
  padding:8px 22px; border-radius:30px;
  background:var(--panel); border:1px solid var(--rim);
  color:var(--muted); font-size:13px; font-weight:600;
  cursor:pointer; transition:.3s var(--ease); font-family:var(--body);
}
.fb:hover { color:var(--text); border-color:rgba(245,197,24,.3); }
.fb.on { background:var(--gold); border-color:var(--gold); color:#000; box-shadow:0 4px 16px rgba(245,197,24,.3); }

/* GRID */
.port-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:26px; }
.pcard { overflow:hidden; }
.pcard.hide { display:none; }
.pcard-img { position:relative; overflow:hidden; height:220px; }
.pcard-img img { width:100%; height:100%; object-fit:cover; transition:transform .6s var(--ease); }
.pcard:hover .pcard-img img { transform:scale(1.1); }
.pcard-ov {
  position:absolute; inset:0;
  background:rgba(4,7,26,.78);
  display:flex; align-items:center; justify-content:center;
  opacity:0; transition:.35s;
}
.pcard:hover .pcard-ov { opacity:1; }
.ov-link {
  display:flex; align-items:center; gap:8px;
  background:#fff; color:#0a0e22;
  padding:9px 20px; border-radius:8px;
  font-size:13px; font-weight:700; text-decoration:none;
  transform:translateY(10px); transition:.35s;
}
.pcard:hover .ov-link { transform:translateY(0); }
.pcard-body { padding:22px; }
.ptag {
  display:inline-block; font-size:10px; font-weight:700; letter-spacing:.12em;
  color:var(--gold); background:rgba(245,197,24,.08); border:1px solid rgba(245,197,24,.2);
  border-radius:20px; padding:3px 12px; margin-bottom:10px;
}
.pcard-body h3 { font-family:var(--display); font-size:18px; font-weight:700; margin-bottom:8px; }
.pcard-body p  { color:var(--muted); font-size:13.5px; line-height:1.6; margin-bottom:14px; }
.ptech { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:14px; }
.ptech span { font-size:11px; padding:3px 10px; background:rgba(79,142,247,.07); border:1px solid rgba(79,142,247,.15); border-radius:20px; color:var(--blue); font-weight:600; }
.plink { color:var(--gold); font-size:13px; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px; transition:.3s; }
.plink:hover { gap:10px; }

/* NO IMG PLACEHOLDER */
.no-shot { height:220px; background:rgba(79,142,247,.04); display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px; color:var(--muted); }
.no-shot i { font-size:36px; opacity:.25; }
.no-shot span { font-size:13px; opacity:.5; }

/* CTA */
.port-cta-sec { padding:0 6% 80px; }
.cta-box { padding:70px 40px; text-align:center; border-color:rgba(79,142,247,.2); background:linear-gradient(135deg,rgba(79,142,247,.04),rgba(245,197,24,.03)); }
.cta-box h2 { font-family:var(--display); font-size:clamp(28px,3.5vw,46px); font-weight:800; margin-bottom:14px; }
.cta-box p  { color:var(--muted); font-size:16px; margin-bottom:30px; }

/* RESPONSIVE */
@media(max-width:1000px) { .port-grid { grid-template-columns:repeat(2,1fr); } }
@media(max-width:600px)  { .port-grid { grid-template-columns:1fr; } }
